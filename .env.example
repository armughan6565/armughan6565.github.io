# Public site URL — used for canonical URLs, sitemap, Open Graph and JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact form delivery (server-side only — never prefix with NEXT_PUBLIC_)
# Enquiries are POSTed as JSON to this endpoint (Zapier/Make webhook, CRM, or your own mail service).
# If unset: development logs enquiries to the console; production returns 503 rather than dropping them.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=

# Contact form endpoint (public, build-time). Leave unset for static hosting (GitHub Pages):
# the form then asks visitors to email site.contact.email. Set to /api/contact on a Node host.
NEXT_PUBLIC_CONTACT_ENDPOINT=
